# =========================================================================
# Template. Copy to .env and fill in.  cp .env.example .env
#
# .env is git-ignored and must never be committed. This file - .env.example -
# is committed, so it must only ever contain placeholder values.
#
# Referenced from config.json as ${VARIABLE_NAME}. A name used in config.json
# but missing here is an error naming the variable, never a blank password.
#
# Rules:
#   - KEY=value, one per line
#   - # starts a comment ONLY at the beginning of a line. Everything after
#     the first = is part of the value, so a password containing # is safe.
#   - quote the value if leading/trailing spaces matter:  KEY=" pw "
#   - a real environment variable of the same name overrides what is here
# =========================================================================

# --- Pilot client --------------------------------------------------------

# Only needed if the Windows VPN entry does NOT have its credentials saved.
# When it does, leave username and password out of config.json entirely and
# this variable goes unused - the safest arrangement, since a secret that does
# not exist cannot be leaked.
PILOT_VPN_PASSWORD=CHANGE_ME

PILOT_SSH_PASSWORD=CHANGE_ME

# Per-environment credentials, if they differ from the client default.
PILOT_PROD_SSH_PASSWORD=CHANGE_ME

# --- Second client -------------------------------------------------------
SECOND_SSH_PASSWORD=CHANGE_ME
