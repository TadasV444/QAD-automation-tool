<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings live in Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>QadAutomation.Core</RootNamespace>

    <!-- The XML comments in this project carry the design rationale, so surface
         a warning if a public type loses its documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- CS1591 (missing XML comment) is not enforced: it would demand a comment
         on every trivial record property for no benefit. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SFTP. The same library the tool would need for SSH later, so the
         compile step will not add another dependency.

         This is an infrastructure dependency in a project otherwise described
         as "all logic". That is consistent rather than a lapse: Core already
         owns ProcessRunner and System.Diagnostics.Process. The rule this
         project follows is that Core knows nothing about *consoles* - about
         there being a user watching - not that it is free of I/O. Protocol
         work belongs here; argument parsing and printing do not. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
