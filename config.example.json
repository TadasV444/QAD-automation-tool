{
  // ---------------------------------------------------------------------
  // Template. Copy to config.json and fill in.
  //
  // config.json is git-ignored and holds client structure: names, hosts,
  // remote paths, compile commands. This file - config.example.json - is
  // committed, so it must only ever contain placeholder values.
  //
  // Passwords do NOT belong here. Write ${VARIABLE_NAME} and put the value
  // in .env, which is also git-ignored.
  //
  //   config.json   "password": "${PILOT_SSH_PASSWORD}"
  //   .env          PILOT_SSH_PASSWORD=hunter2
  //
  // Check your work with:  qad validate
  // ---------------------------------------------------------------------

  "workingFolder": "C:\\QAD Tasks",

  "clients": [
    {
      // 'id' is what you type on the command line. Short and stable.
      "id": "pilot",
      "displayName": "Pilot Client",

      "vpn": {
        // None       - the tool neither dials nor checks; you are on the
        //              network already, and a bad guess shows up as an SSH
        //              failure a moment later.
        // WindowsRas - dialled with rasdial, and disconnected afterwards if
        //              this run was what opened it.
        // FortiClient- CHECKED, not dialled. FortiClient ships no connect
        //              command and its SSL-VPN cannot be dialled by Windows
        //              either, so the tool confirms the tunnel's network
        //              adapter is up and stops with a clear message if it is
        //              not. You click Connect once; everything after that is
        //              automated. See the second client below.
        "type": "WindowsRas",
        // Exactly as `Get-VpnConnection | Select-Object Name` reports it.
        "connectionName": "EXAMPLE-VPN"

        // Preferably leave username and password out entirely. If the Windows
        // VPN entry was saved with "remember my credentials", rasdial connects
        // on the name alone and no VPN password exists for anything to leak.
        //
        // Supply them only where that is not an option. Set BOTH or NEITHER -
        // one without the other makes rasdial prompt, which cannot be
        // answered. A password given this way is briefly readable in the
        // process list, which is a limitation of rasdial itself.
        //
        // "username": "CHANGE_ME",
        // "password": "${PILOT_VPN_PASSWORD}"
      },

      // Inherited by every environment below. Anything an environment sets
      // again overrides what is here.
      "defaults": {
        "port": 22,
        "username": "CHANGE_ME",
        "password": "${PILOT_SSH_PASSWORD}",
        // Prefer a key where the server allows it - then no password is
        // needed in .env at all.
        "privateKeyPath": null,

        "srcRemotePath": "/qad/live/src",
        "qrfRemotePath": "/qad/live/qrf",

        // Both halves are optional. Leave one out and the tool will say that
        // kind cannot be compiled for this environment, rather than guessing.
        //
        // Each half names WHICH procedure the site uses. There are three, and
        // exactly one must be named per kind:
        //
        //   editor    a Progress procedure editor driven by function keys
        //   manifest  a list file plus a build script run once per language
        //   shell     one ordinary command that finds its own work
        //
        // QRF can use 'editor' or 'shell'; SRC can use 'manifest' or 'shell'.
        "compile": {

          // An interactive editor, driven by keystrokes. The .r timestamp is
          // then checked to see whether it actually built.
          "qrf": {
            "editor": {
              // The whole command, because its arguments are the site's. Use
              // {language} where the wrapper takes one.
              "editorCommand": "/qad/live/qrf/compile_editor us live",

              // Optional. Omit where the command is an absolute path, as here.
              // "workingDirectory": "/qad/live/qrf",

              // Optional. Where the wrapper is opened once per language.
              // "languages": ["lt", "us"],

              // Optional. What to send per program, in order. Defaults to
              // exactly the line below - F4 clears the buffer, the text is
              // typed, Return commits it, F1 runs it.
              //
              // These belong to the client's wrapper script, not to Progress:
              // another site's is entered with Enter and run with F1 twice, as
              //   ["Enter", "Statement", "Go", "Go"]
              // Named steps only - Statement, Enter, Go (F1), NewBuffer (F4) -
              // so nobody has to write escape sequences into JSON.
              "steps": ["NewBuffer", "Statement", "Enter", "Go"],

              // Optional. True where the wrapper takes one program per run and
              // must be reopened for the next. Defaults to false.
              // "restartPerFile": true,

              // Optional. Defaults to exactly this. Placeholders:
              //   {remoteFile}       the uploaded .p, full remote path
              //   {remoteDirectory}  where the .r should land
              //
              // Some wrappers want a bare path instead - "{remoteFile}".
              "statement": "compile {remoteFile} save into {remoteDirectory}."
            }
          },

          // Write the manifest, then run the compile script once per language.
          "src": {
            "manifest": {
              "workingDirectory": "/qad/global",

              // Run once per language below. The environment, where the script
              // takes one, is part of the command - it is the script's own
              // argument.
              "command": "./compile {language} live",

              // Per language: the list of programs it compiles, and the root
              // its output lands under. The compiled files sit one level
              // deeper, in a folder named after the program's first two
              // letters - so xxfoo.p becomes /qad/global/lt/xx/xxfoo.r and
              // /qad/global/us/xx/xxfoo.r, and BOTH must build for the program
              // to count as compiled.
              //
              // Point both languages at the same manifestPath where the site
              // shares one file; it is then written once.
              "languages": {
                "lt": {
                  "manifestPath": "/qad/global/lt/utcompil.wrk",
                  "resultPath": "/qad/global/lt"
                },
                "us": {
                  "manifestPath": "/qad/global/us/utcompil.wrk",
                  "resultPath": "/qad/global/us"
                }
              }
            }
          }
        }
      },

      "environments": [
        { "name": "DEVL", "host": "devl.example.local", "srcRemotePath": "/qad/devl/src", "qrfRemotePath": "/qad/devl/qrf" },
        { "name": "TEST", "host": "test.example.local", "srcRemotePath": "/qad/test/src", "qrfRemotePath": "/qad/test/qrf" },

        // Names like PROD / LIVE / PRODUCTION are treated as production
        // automatically. Set "isProduction" explicitly to override that.
        // A separate secret is used here because production credentials
        // usually differ.
        //
        // "aliases" are other words this environment answers to on the command
        // line, for sites whose own vocabulary differs - `qad deploy pilot euro
        // 9999555 --yes` here. They are matched case-insensitively, like names.
        //
        // Two things worth knowing:
        //   - the CANONICAL name is what every message reports, whichever word
        //     was typed, so two people deploying the same thing leave the same
        //     record;
        //   - an alias never makes an environment production. That is inferred
        //     from the real name, or stated with "isProduction" - otherwise a
        //     harmless-looking alias could quietly disarm the guard.
        //
        // Config is rejected if two environments of one client share any name
        // or alias.
        {
          "name": "PROD",
          "aliases": ["euro"],
          "host": "prod.example.local",
          "password": "${PILOT_PROD_SSH_PASSWORD}"
        }
      ]
    },

    {
      "id": "second",
      "displayName": "Second Client",

      "vpn": {
        "type": "FortiClient",

        // The tunnel's name in FortiClient. Used to name it in the message
        // asking you to connect it, which is this type's whole behaviour.
        "connectionName": "EXAMPLE-TUNNEL",

        // Optional. The tool recognises the tunnel by its network adapter, and
        // by default matches the names Fortinet's driver usually takes. Set
        // this only if 'qad vpn status' reports disconnected while FortiClient
        // shows connected - the error lists every adapter that is up, so put
        // distinctive text from the right one here.
        //
        // "adapterName": "EXAMPLE-TUNNEL"

        // No username or password: nothing reads them for this type. Keep the
        // real ones in .env anyway - that is where a client's credentials
        // belong, and it is the first place to look if FortiClient ever gains
        // a usable command line.
      },

      "defaults": {
        "host": "qad.example.local",
        "username": "CHANGE_ME",
        "password": "${SECOND_SSH_PASSWORD}",
        // {prefix} is the program's first two characters, so xxfoo.p goes to
        // /qad/src/xx and sfbar.p to /qad/src/sf. Leave the placeholder out
        // where a site keeps every SRC program in one directory.
        "srcRemotePath": "/qad/src/{prefix}",
        "qrfRemotePath": "/qad/qrf",

        // This site has a build script that finds its own work, so there is
        // nothing to list and nothing to type.
        "compile": {
          "qrf": {
            "shell": {
              "workingDirectory": "/qad/apps",
              "command": "./build reports -v"
            }
          },

          "src": {
            "shell": {
              "workingDirectory": "/qad/apps",
              "command": "./build customizations -v",

              // Optional, and worth setting. Without it the command's exit
              // code is the only signal, so a script that always exits 0 would
              // report a failed compile as a success. With it, these
              // timestamps decide and the exit code is only reported.
              //   {prefix}  the program's first two characters
              //   {name}    the file name without its extension
              "resultPath": "/qad/build/{prefix}/{name}.r"
            }
          }
        }
      },

      "environments": [
        { "name": "TEST" },
        { "name": "PROD", "host": "qad-prod.example.local" }
      ]
    }
  ]
}
